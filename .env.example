# Path to the SQLite database file. Defaults to ./data/app.db when unset.
DATABASE_PATH=./data/app.db

# AI Insights provider. Leave unset (with no ANTHROPIC_API_KEY) and the page
# shows an "unavailable" state; the rest of the app is unaffected.
# AI_PROVIDER=mock       # deterministic, network-free provider (used in e2e tests)
# AI_PROVIDER=disabled   # explicitly turn AI Insights off
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5
